+
+fun parsearColor(colorTexto: String): Color {
+    val textoLimpio = colorTexto.trim().lowercase()
+    return when (textoLimpio) {
+        "rojo", "red" -> Color(0xFFE57373)
+        "azul", "blue" -> Color(0xFF64B5F6)
+        "verde", "green" -> Color(0xFF81C784)
+        "amarillo", "yellow" -> Color(0xFFFFF176)
+        "naranja", "orange" -> Color(0xFFFFB74D)
+        "morado", "purpura", "púrpura", "purple" -> Color(0xFFBA68C8)
+        "rosa", "rosado", "pink" -> Color(0xFFF48FB1)
+        "gris", "gray", "grey" -> Color(0xFFE0E0E0)
+        "cian", "cyan" -> Color(0xFF4DD0E1)
+        "negro", "black" -> Color(0xFF424242)
+        "blanco", "white" -> Color(0xFFFFFFFF)
+        else -> {
+            try {
+                if (textoLimpio.startsWith("#")) {
+                    Color(android.graphics.Color.parseColor(textoLimpio))
+                } else if (textoLimpio.length == 6 || textoLimpio.length == 8) {
+                    Color(android.graphics.Color.parseColor("#$textoLimpio"))
+                } else {
+                    Color(0xFFE0E0E0)
+                }
+            } catch (_: Exception) {
+                Color(0xFFE0E0E0)
+            }
+        }
+    }
+}
+
+fun esColorOscuro(color: Color): Boolean {
+    val luminancia = 0.299 * color.red + 0.587 * color.green + 0.114 * color.blue
+    return luminancia < 0.5f
 }
